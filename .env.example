# ============================================
#  ISAIAH PORTFOLIO — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ============================================

# Node environment: development | production
NODE_ENV=development

# Server port
PORT=3000

# MongoDB connection string
# Get from MongoDB Atlas or local install
MONGO_URI=mongodb://127.0.0.1:27017/isaiah_portfolio

# Session secret — use a long random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_secret_string

# Admin login credentials
# Change these before deploying to production
ADMIN_USERNAME=isaiah_admin
ADMIN_PASSWORD=YourStrongPassword123!

# Allowed origin for CORS (your production domain)
ALLOWED_ORIGIN=http://localhost:3000
